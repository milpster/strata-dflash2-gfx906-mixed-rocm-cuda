# ab9 window data file: paths read by ab9_pcie_ctx.sh into variables.
# The forbidden literal strings (the launcher name, the rpcw-* binaries, the serve script)
# live ONLY here — never on any wrapper cmdline (banked self-match lesson: stop-prod's
# pkill 'bash .*launch-prod-' killed wrappers that carried the pattern in their argv).
AB9_LAUNCHER=/mnt/srcds/Strata/launch-prod-swift15-f16kv-dflash-w4-q4_0-mixed.sh
AB9_CONFIG=/mnt/srcds/Strata/prod-config-swift15-f16kv-dflash-w4-q4_0-mixed.json
AB9_ENGINE=/mnt/srcds/Strata/v0214/build-mixed-gpu/rpcw-hip/strata
AB9_HELPER=/mnt/srcds/Strata/v0214/build-mixed-gpu/rpcw-cuda/strata-expert-helper-patient
AB9_SERVE=/mnt/srcds/Strata/v0214/serve/server.py
# The live pair boots from this worktree (launcher: WORK="$ROOT/v0214"); serve must run with
# that cwd, the same as prod. Re-point these three + WORK together when the prod worktree moves.
AB9_WORK=/mnt/srcds/Strata/v0214
AB9_PY=/mnt/srcds/Strata/.venv/bin/python
AB9_SOCKET=/mnt/srcds/Strata/run/prod-swift15-f16kv-mixed.sock
AB9_SOCKET2=/mnt/srcds/Strata/run/prod-swift15-f16kv-mixed2.sock
AB9_PORT=8009
AB9_HELPER_SLOTS=4600
AB9_HELPER_FILL_MIB=6796
AB9_HELPER_RESERVE_MIB=300
AB9_HELPER_TIMEOUT=63115200000
AB9_ROCM_LIBS=${STRATA_ROCM_ROOT:-/home/srcds/rocm-gfx906-xnack}/lib:/opt/rocm-6.1.0/lib
# dmon flags: SPEC-ab9 asks for 'nvidia-smi dmon -s utr -d 1'. On this driver 'r' has no
# metric (verified 2026-11-08: '-s r' -> "Failed to find any metric"). '-s utp' is the
# supported superset that carries the SPEC intent: util (sm/mem) + temperature + PCIe rxpci/txpci MB/s.
AB9_DMON_FLAGS="utp"
